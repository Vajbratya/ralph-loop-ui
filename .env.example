# Required: GitHub repository in owner/repo format
AGENT_LOOP_REPO="owner/repo"

# Required: GitHub token with repo scope permissions
# Either AGENT_LOOP_TOKEN or GITHUB_TOKEN must be set
AGENT_LOOP_TOKEN="ghp_your_github_token_here"

# Alternative: Use GITHUB_TOKEN instead of AGENT_LOOP_TOKEN
# GITHUB_TOKEN="ghp_your_github_token_here"
